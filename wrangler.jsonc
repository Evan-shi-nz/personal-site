// Cloudflare Workers config: static site from ./dist, the /api/* routes and the X sync cron.
// Deployed by Cloudflare Workers Builds on every push (build: `npm run build`, deploy: `npx wrangler deploy`).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "personal-site",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // /blog serves blog.html; unknown paths get dist/404.html with status 404
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // The Worker runs first for every request: it answers /api/*, sends www to the bare
    // domain, and passes everything else to the static files.
    "run_worker_first": true
  },
  // Custom domains: wrangler creates the DNS records and certificates on deploy.
  "routes": [
    { "pattern": "evanshi.nz", "custom_domain": true },
    { "pattern": "www.evanshi.nz", "custom_domain": true }
  ],
  // Keep the workers.dev address working too
  "workers_dev": true,
  // `wrangler dev` would otherwise pretend requests come from http://evanshi.nz and hit the https redirect
  "dev": { "host": "localhost" },
  // Guestbook storage. No database_id: wrangler creates the database on the first deploy.
  "d1_databases": [{ "binding": "DB", "database_name": "personal-site-guestbook" }],
  // Cron Triggers (UTC), see scheduled() in worker/index.js:
  //   every 3 hours:  sync posts from X (does nothing until X_BEARER_TOKEN and GITHUB_TOKEN are set)
  //   every 12 hours: read new Stripe transactions for the revenue page
  "triggers": { "crons": ["23 */3 * * *", "41 */12 * * *"] },
  "vars": {
    "X_USERNAME": "EvanShi_nz",
    "GITHUB_REPO": "Evan-shi-nz/personal-site",
    "GITHUB_BRANCH": "main",
    // Mirror for visitors in mainland China, e.g. "https://cn.evanshi.nz". Empty = off. See deploy/cn-mirror.
    "CN_MIRROR": "https://cn.evanshi.nz"
  },
  // Keep variables and secrets set in the dashboard (PUBLIC_STRIPE_VERIFY_KEY, tokens) across deploys
  "keep_vars": true,
  "observability": { "enabled": true }
}
