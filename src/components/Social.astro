---
import { site } from "../site.config";
const { x, linkedin, github, email, whatsapp } = site.links as Record<string, string>;

// Brand marks from Simple Icons (CC0); the mail icon is a plain outline.
const icons = {
  x: '<path fill="currentColor" d="M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z"/>',
  linkedin: '<path fill="currentColor" d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.71 1.637-1.459 3.37-1.459 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.064 2.064 0 1 1 0-4.128 2.064 2.064 0 0 1 0 4.128zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>',
  github: '<path fill="currentColor" d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>',
  whatsapp: '<path fill="currentColor" d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/>',
  email: '<g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2.5" y="4.5" width="19" height="15" rx="2"/><path d="m3 6.5 9 6.5 9-6.5"/></g>',
};
const handle = (url: string) => url.replace(/\/+$/, "").split("/").pop();
const items = [
  x && { key: "x", label: "X", detail: `@${handle(x)}`, href: x },
  linkedin && { key: "linkedin", label: "LinkedIn", detail: handle(linkedin), href: linkedin },
  github && { key: "github", label: "GitHub", detail: `@${handle(github)}`, href: github },
].filter(Boolean) as { key: keyof typeof icons; label: string; detail: string; href: string }[];
const svg = (key: keyof typeof icons) => `<svg viewBox="0 0 24 24" aria-hidden="true">${icons[key]}</svg>`;
---
<ul class="contacts">
  {items.map((it) => (
    <li>
      <a class="row" href={it.href} target="_blank" rel="me noopener noreferrer">
        <span class="tile" set:html={svg(it.key)} />
        <span class="text"><span class="label">{it.label}</span><span class="detail">{it.detail}</span></span>
        <span class="go" aria-hidden="true">↗</span>
      </a>
    </li>
  ))}
  {whatsapp && (
    <li>
      <button type="button" class="row" data-open-dialog="wa-dialog" aria-haspopup="dialog">
        <span class="tile" set:html={svg("whatsapp")} />
        <span class="text"><span class="label">WhatsApp</span></span>
      </button>
    </li>
  )}
  {email && (
    <li>
      <button type="button" class="row" data-copy-email={email} title={email}>
        <span class="tile" set:html={svg("email")} />
        <span class="text"><span class="label">Email</span></span>
      </button>
    </li>
  )}
</ul>

{whatsapp && (
  <dialog id="wa-dialog" class="modal" aria-labelledby="wa-title">
    <button type="button" class="close" data-close-dialog aria-label="Close">×</button>
    <h2 id="wa-title">WhatsApp</h2>
    <p class="muted small">Scan with your phone's camera or WhatsApp.</p>
    <img src="/images/whatsapp-qr.png" width="240" height="240" alt="WhatsApp QR code for Evan Shi" loading="lazy" />
    <a class="open" href={whatsapp} target="_blank" rel="noopener noreferrer">Open in WhatsApp ↗</a>
  </dialog>
)}

<div class="toast" id="copy-toast" role="status" aria-live="polite" hidden></div>

<script>
  // WhatsApp: QR code in a dialog in the middle of the screen
  document.querySelectorAll<HTMLButtonElement>("[data-open-dialog]").forEach((btn) =>
    btn.addEventListener("click", () => (document.getElementById(btn.dataset.openDialog!) as HTMLDialogElement).showModal()),
  );
  document.querySelectorAll<HTMLDialogElement>("dialog.modal").forEach((d) => {
    d.querySelector("[data-close-dialog]")?.addEventListener("click", () => d.close());
    // Clicking the dimmed area outside the box closes it
    d.addEventListener("click", (e) => {
      const r = d.getBoundingClientRect();
      const inside = e.clientX >= r.left && e.clientX <= r.right && e.clientY >= r.top && e.clientY <= r.bottom;
      if (!inside) d.close();
    });
  });

  // Email: copy the address and confirm in the middle of the screen
  const toast = document.getElementById("copy-toast")!;
  let hideTimer: number | undefined;
  function showToast(html: string) {
    toast.innerHTML = html;
    toast.hidden = false;
    toast.classList.remove("show");
    void toast.offsetWidth; // restart the animation
    toast.classList.add("show");
    clearTimeout(hideTimer);
    hideTimer = window.setTimeout(() => (toast.hidden = true), 2200);
  }
  document.querySelectorAll<HTMLButtonElement>("[data-copy-email]").forEach((btn) =>
    btn.addEventListener("click", async () => {
      const email = btn.dataset.copyEmail!;
      try {
        await navigator.clipboard.writeText(email);
        showToast(`<strong>Email copied</strong><span>${email}</span>`);
      } catch {
        // Clipboard not available (old browser, insecure page): show the address to copy by hand
        showToast(`<strong>Copy this email</strong><span>${email}</span>`);
      }
    }),
  );
</script>

<style>
  .contacts { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 4px; }
  .row {
    display: flex; align-items: center; gap: 14px; padding: 8px 10px; margin: 0 -10px; width: calc(100% + 20px);
    border: 0; background: transparent; font: inherit; text-align: left;
    border-radius: 12px; text-decoration: none; color: var(--fg); cursor: pointer;
    transition: background 0.15s;
  }
  .row:hover { background: var(--soft); }
  .row:focus-visible { outline: 2px solid var(--fg); outline-offset: 0; }
  .tile {
    width: 36px; height: 36px; flex: none; display: grid; place-items: center;
    border-radius: 10px; border: 1px solid var(--line); background: var(--bg);
  }
  .tile :global(svg) { width: 17px; height: 17px; }
  .text { display: flex; flex-direction: column; line-height: 1.3; min-width: 0; flex: 1; }
  .label { font-size: 15px; font-weight: 600; }
  .detail { font-size: 13px; color: var(--muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .go { color: var(--muted); font-size: 14px; opacity: 0; transition: opacity 0.15s; }
  .row:hover .go { opacity: 1; }

  /* Centered dialog for the WhatsApp QR code */
  .modal {
    border: 1px solid var(--line); border-radius: 18px; padding: 28px 28px 22px; width: min(340px, calc(100vw - 32px));
    background: var(--bg); color: var(--fg); text-align: center; box-shadow: 0 20px 60px rgb(0 0 0 / 0.25);
  }
  .modal::backdrop { background: rgb(0 0 0 / 0.45); backdrop-filter: blur(2px); }
  .modal[open] { animation: pop 0.18s ease-out; }
  .modal h2 { margin: 0 0 4px; font-size: 1.2rem; }
  .modal p { margin: 0 0 16px; }
  .modal img { display: block; width: 240px; max-width: 100%; height: auto; margin: 0 auto 14px; border-radius: 12px; border: 1px solid var(--line); background: #fff; }
  .modal .open { font-size: 14px; font-weight: 600; }
  .close {
    position: absolute; top: 10px; right: 12px; width: 32px; height: 32px; border: 0; border-radius: 50%;
    background: transparent; color: var(--muted); font-size: 22px; line-height: 1; cursor: pointer;
  }
  .close:hover { background: var(--soft); color: var(--fg); }

  /* "Email copied" message in the middle of the screen */
  .toast {
    position: fixed; z-index: 1001; left: 50%; top: 50%; transform: translate(-50%, -50%);
    display: flex; flex-direction: column; align-items: center; gap: 2px; padding: 14px 22px;
    border-radius: 14px; background: var(--fg); color: var(--bg); font-size: 14px; text-align: center;
    box-shadow: 0 12px 40px rgb(0 0 0 / 0.25); pointer-events: none; max-width: calc(100vw - 32px);
  }
  .toast :global(strong) { font-size: 15px; }
  .toast :global(span) { opacity: 0.75; overflow-wrap: anywhere; }
  .toast.show { animation: toast 2.2s ease forwards; }
  @keyframes pop { from { opacity: 0; transform: scale(0.96); } to { opacity: 1; transform: scale(1); } }
  @keyframes toast {
    0% { opacity: 0; transform: translate(-50%, -46%); }
    10%, 80% { opacity: 1; transform: translate(-50%, -50%); }
    100% { opacity: 0; transform: translate(-50%, -50%); }
  }

  /* Narrow screens: two columns to save space */
  @media (max-width: 860px) {
    .contacts { display: grid; grid-template-columns: 1fr 1fr; gap: 4px 12px; }
  }
  @media (prefers-reduced-motion: reduce) { .row, .go { transition: none; } .modal[open], .toast.show { animation: none; } }
</style>
