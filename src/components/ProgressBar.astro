---
// Thin loading bar at the top of the page (NProgress, MIT).
// Shows while moving to another page of this site and while the page loads data from /api/*.
---
<script>
  import NProgress from "nprogress";

  NProgress.configure({ showSpinner: false, minimum: 0.15, trickleSpeed: 150, speed: 250 });

  // 1. Page changes: start as soon as an internal link is clicked; the new page replaces this one.
  document.addEventListener("click", (e) => {
    if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
    const a = (e.target as HTMLElement).closest("a");
    if (!a || !a.href || a.target === "_blank" || a.hasAttribute("download")) return;
    const url = new URL(a.href, location.href);
    if (url.origin !== location.origin || url.pathname.startsWith("/api/")) return;
    if (url.pathname === location.pathname && url.search === location.search) return; // same page / #anchor
    NProgress.start();
  });
  // Coming back with the browser's Back button can restore a page with the bar still running.
  // (pageshow also fires on a normal load, so only act when the page came from the back/forward cache.)
  window.addEventListener("pageshow", (e) => {
    if (e.persisted) NProgress.done(true);
  });

  // 2. Data loading: count requests to this site's /api/* and show the bar while any is running.
  let active = 0;
  const originalFetch = window.fetch.bind(window);
  window.fetch = async (input, init) => {
    const raw = typeof input === "string" ? input : input instanceof URL ? input.href : input.url;
    const url = new URL(raw, location.href);
    const track = url.origin === location.origin && url.pathname.startsWith("/api/");
    if (track && active++ === 0) NProgress.start();
    try {
      return await originalFetch(input, init);
    } finally {
      if (track && --active === 0) NProgress.done();
    }
  };
</script>

<style is:global>
  /* NProgress styles, adapted to the site: orange like the avatar, above everything */
  #nprogress { pointer-events: none; }
  #nprogress .bar {
    position: fixed; z-index: 1000; top: 0; left: 0; width: 100%; height: 3px;
    background: linear-gradient(90deg, #ff5a36, #ffb03a);
  }
  #nprogress .peg {
    display: block; position: absolute; right: 0; width: 100px; height: 100%;
    box-shadow: 0 0 10px #ff7a33, 0 0 5px #ff7a33; opacity: 1;
    transform: rotate(3deg) translate(0, -4px);
  }
  @media (prefers-reduced-motion: reduce) { #nprogress .peg { display: none; } }
</style>
