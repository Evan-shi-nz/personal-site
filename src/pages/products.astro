---
import { newTab } from "../lib/links";
import Base from "../layouts/Base.astro";
import { site } from "../site.config";
import { RANGES } from "../lib/revenue-client";

// Projects and numbers come from /api/revenue at runtime (Cloudflare secret STRIPE_REVENUE_KEYS),
// so adding a project needs no rebuild. Keys never reach the browser.
const { currency, rates } = site.revenue;
---
<Base title="Indie products" description="Small AI products Evan Shi builds and runs on his own, with revenue read from Stripe and verified on TrustMRR.">
  <h1>Indie products</h1>
  <p class="muted">
    I build and run small AI products on my own, end to end: product, AI pipelines, payments and
    deployment. I don't name them here, but the revenue below is real and each product is verified on <a href="https://trustmrr.com" {...newTab}>TrustMRR</a>.
  </p>

  <section class="rev-card" id="rev" data-currency={currency} data-rates={JSON.stringify(rates)} aria-live="polite">
    <div class="rev-top">
      <div class="headline">
        <div><span class="amount" id="rev-total">–</span> <span class="muted" id="rev-period">in the last 30 days</span></div>
        <div class="small" id="rev-change"></div>
      </div>
      <label class="picker">
        <span class="visually-hidden">Product</span>
        <select id="rev-project" disabled>
          <option value="all">All products</option>
        </select>
      </label>
    </div>

    <div class="rev-bar">
      <div class="range-tabs" role="tablist" aria-label="Time range">
        {RANGES.map((r) => (
          <button type="button" role="tab" data-range={r.key} aria-selected={r.key === "30d" ? "true" : "false"} title={r.long}>
            {r.label}
          </button>
        ))}
      </div>
      <!-- One project selected: a direct link. All projects: a menu with each project's TrustMRR page. -->
      <a id="rev-verify" class="verify" target="_blank" rel="noopener noreferrer" hidden>✓ Verified on TrustMRR ↗</a>
      <details id="rev-verify-all" class="verify-menu" hidden>
        <summary class="verify">✓ Verified on TrustMRR</summary>
        <ul id="rev-verify-list"></ul>
      </details>
    </div>

    <div class="chart-wrap">
      <canvas id="rev-canvas" role="img" aria-label="Revenue chart"></canvas>
      <p class="muted chart-empty" id="rev-empty">Loading revenue…</p>
    </div>
    <p class="small muted rev-note" id="rev-note"></p>
  </section>

  <!-- One line per product from site.productNotes; hidden while none are filled in -->
  <section id="about-products" data-notes={JSON.stringify(site.productNotes)} hidden>
    <h2>What I built</h2>
    <dl class="product-notes" id="product-notes"></dl>
  </section>
</Base>

<style>
  .rev-card { border: 1px solid var(--line); border-radius: 14px; padding: 18px 18px 12px; margin: 24px 0 8px; }
  .rev-top { display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; flex-wrap: wrap; }
  .headline .amount { font-size: 2rem; font-weight: 700; letter-spacing: -0.02em; font-variant-numeric: tabular-nums; }
  .headline { min-width: 0; }
  :global(#rev-change .up) { color: var(--good); font-weight: 600; }
  :global(#rev-change .down) { color: #d4483b; font-weight: 600; }
  .picker select {
    font: inherit; font-size: 16px; color: var(--fg); background: var(--bg);
    border: 1px solid var(--line); border-radius: 10px; padding: 7px 34px 7px 12px; max-width: 240px;
    appearance: none; cursor: pointer;
    background-image: linear-gradient(45deg, transparent 50%, var(--muted) 50%), linear-gradient(135deg, var(--muted) 50%, transparent 50%);
    background-position: calc(100% - 17px) 55%, calc(100% - 12px) 55%;
    background-size: 5px 5px; background-repeat: no-repeat;
  }
  .picker select:focus-visible { outline: 2px solid var(--fg); outline-offset: 2px; }
  .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .rev-bar { display: flex; justify-content: space-between; align-items: center; gap: 8px 12px; flex-wrap: wrap; margin: 16px 0 10px; }
  .range-tabs { display: inline-flex; gap: 2px; background: var(--soft); border-radius: 10px; padding: 3px; }
  .range-tabs button { background: transparent; color: var(--muted); border: 0; padding: 4px 11px; font-size: 13px; font-weight: 600; border-radius: 8px; }
  .range-tabs button[aria-selected="true"] { background: var(--bg); color: var(--fg); box-shadow: 0 1px 2px rgb(0 0 0 / 0.12); }
  .verify { display: inline-block; padding: 8px 0; font-size: 14px; font-weight: 600; color: var(--good); text-decoration: none; }
  .verify:hover { text-decoration: underline; }
  .verify-menu { position: relative; }
  .verify-menu summary { cursor: pointer; list-style: none; }
  .verify-menu summary::-webkit-details-marker { display: none; }
  .verify-menu summary::after { content: " ▾"; font-size: 11px; }
  .verify-menu[open] summary::after { content: " ▴"; }
  .verify-menu ul {
    position: absolute; right: 0; top: calc(100% + 6px); z-index: 5; list-style: none; margin: 0; padding: 6px;
    min-width: 200px; max-height: 280px; overflow-y: auto;
    background: var(--bg); border: 1px solid var(--line); border-radius: 10px; box-shadow: 0 6px 24px rgb(0 0 0 / 0.12);
  }
  :global(.verify-menu li a) { display: flex; justify-content: space-between; gap: 12px; padding: 7px 10px; border-radius: 6px; text-decoration: none; font-size: 14px; color: var(--fg); }
  :global(.verify-menu li a:hover) { background: var(--soft); }
  @media (max-width: 560px) { .verify-menu ul { left: 0; right: auto; } }
  .chart-wrap { position: relative; height: 240px; }
  .chart-empty { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; margin: 0; }
  .chart-empty[hidden] { display: none; }
  .rev-note { margin: 10px 0 0; }
  .product-notes { margin: 0; display: grid; grid-template-columns: max-content 1fr; gap: 8px 16px; font-size: 15.5px; }
  :global(.product-notes dt) { font-weight: 600; }
  :global(.product-notes dd) { margin: 0; color: var(--muted); }
  @media (max-width: 480px) { .product-notes { grid-template-columns: 1fr; gap: 2px; } :global(.product-notes dd) { margin-bottom: 10px; } }
  .rev-note:empty { display: none; }
</style>

<script>
  import { BarController, BarElement, CategoryScale, Chart, LinearScale, Tooltip, type TooltipItem } from "chart.js";
  import { RANGES, formatMoney, loadProjects, percentChange, rangeKeys, sumKeys, type Project, type RangeKey } from "../lib/revenue-client";

  Chart.register(BarController, BarElement, CategoryScale, LinearScale, Tooltip);

  const box = document.getElementById("rev")!;
  const CUR = box.dataset.currency!;
  const RATES: Record<string, number> = JSON.parse(box.dataset.rates!);
  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
  const money = (c: number, d = 0) => formatMoney(c, CUR, d);
  // Distinct colours for stacked projects; the last one is for "Others".
  const PALETTE = ["#2f6fed", "#f08c00", "#1d9a6c", "#d6336c", "#7048e8"];
  const MAX_STACKED = 5;

  let projects: Project[] = []; // sorted: most revenue in the last 30 days first
  let selected = "all";
  let range: RangeKey = "30d";
  let chart: Chart | null = null;

  const css = (name: string) => getComputedStyle(document.documentElement).getPropertyValue(name).trim();

  function axisLabel(key: string, unit: "days" | "months") {
    if (unit === "months") {
      const [y, m] = key.split("-").map(Number);
      return new Date(Date.UTC(y, m - 1, 1)).toLocaleDateString("en-NZ", { month: "short", timeZone: "UTC" });
    }
    return new Date(key + "T00:00:00Z").toLocaleDateString("en-NZ", { day: "numeric", month: "short", timeZone: "UTC" });
  }
  function tooltipTitle(key: string, unit: "days" | "months") {
    if (unit === "months") {
      const [y, m] = key.split("-").map(Number);
      return new Date(Date.UTC(y, m - 1, 1)).toLocaleDateString("en-NZ", { month: "long", year: "numeric", timeZone: "UTC" });
    }
    return new Date(key + "T00:00:00Z").toLocaleDateString("en-NZ", { weekday: "short", day: "numeric", month: "long", year: "numeric", timeZone: "UTC" });
  }

  function render() {
    const ok = projects.filter((p) => !p.error);
    const shown = selected === "all" ? ok : ok.filter((p) => p.id === selected);
    const { unit, current, previous } = rangeKeys(range);
    const meta = RANGES.find((r) => r.key === range)!;

    // Headline: total for the range and change against the period before.
    const now = shown.reduce((a, p) => a + sumKeys(p, unit, current), 0);
    const before = shown.reduce((a, p) => a + sumKeys(p, unit, previous), 0);
    // A previous period with almost nothing in it (e.g. before the first sale) makes a percentage meaningless.
    const pct = before * 100 < now ? null : percentChange(now, before);
    $("rev-total").textContent = money(now);
    $("rev-period").textContent = `in the ${meta.long}`;
    $("rev-change").innerHTML =
      pct === null
        ? now ? `<span class="up">New</span>` : ""
        : `<span class="${pct >= 0 ? "up" : "down"}">${pct >= 0 ? "↑" : "↓"} ${Math.abs(pct).toFixed(1)}%</span> <span class="muted">vs previous ${meta.long.replace("last ", "")}</span>`;

    // TrustMRR: a direct link for one project, a menu of every project's page for "All projects".
    const one = selected === "all" ? null : ok.find((p) => p.id === selected);
    const verify = $<HTMLAnchorElement>("rev-verify");
    verify.hidden = !one?.trustmrr;
    if (one?.trustmrr) verify.href = one.trustmrr;
    const verified = ok.filter((p) => p.trustmrr);
    const menu = $<HTMLDetailsElement>("rev-verify-all");
    menu.hidden = !!one || verified.length === 0;
    menu.open = false;
    $("rev-verify-list").innerHTML = verified
      .map((p) => `<li><a href="${p.trustmrr!.replace(/"/g, "&quot;")}" target="_blank" rel="noopener noreferrer"><span>${p.label.replace(/[<&]/g, "")}</span><span class="muted">TrustMRR ↗</span></a></li>`)
      .join("");

    // Datasets: one per project (top ones by revenue in this range), the rest as "Others".
    const ranked = [...shown].sort((a, b) => sumKeys(b, unit, current) - sumKeys(a, unit, current));
    const top = ranked.length > MAX_STACKED + 1 ? ranked.slice(0, MAX_STACKED) : ranked;
    const rest = ranked.slice(top.length);
    const single = shown.length === 1;
    const datasets = top.map((p, i) => ({
      label: p.label,
      data: current.map((k) => ((unit === "days" ? p.days : p.months)[k] ?? 0) / 100),
      backgroundColor: single ? css("--fg") : PALETTE[i % PALETTE.length],
    }));
    if (rest.length) {
      datasets.push({
        label: `Others (${rest.length})`,
        data: current.map((k) => rest.reduce((a, p) => a + ((unit === "days" ? p.days : p.months)[k] ?? 0), 0) / 100),
        backgroundColor: css("--muted"),
      });
    }

    $("rev-empty").hidden = true;
    const fg = css("--fg"), bg = css("--bg"), muted = css("--muted"), line = css("--line");
    const config = {
      type: "bar" as const,
      data: { labels: current.map((k) => axisLabel(k, unit)), datasets },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        animation: { duration: 250 },
        interaction: { mode: "index" as const, intersect: false },
        datasets: { bar: { borderRadius: 3, borderSkipped: false, categoryPercentage: 0.8, barPercentage: 0.9, maxBarThickness: 44 } },
        scales: {
          x: { stacked: true, grid: { display: false }, border: { display: false }, ticks: { color: muted, maxRotation: 0, autoSkip: true, maxTicksLimit: unit === "months" ? 12 : 8, font: { size: 12 } } },
          y: {
            stacked: true,
            beginAtZero: true,
            grid: { color: line },
            border: { display: false, dash: [4, 4] },
            ticks: { color: muted, maxTicksLimit: 5, font: { size: 12 }, callback: (v: string | number) => money(Number(v) * 100) },
          },
        },
        plugins: {
          legend: { display: false },
          tooltip: {
            backgroundColor: bg,
            titleColor: fg,
            bodyColor: fg,
            footerColor: fg,
            borderColor: line,
            borderWidth: 1,
            padding: 12,
            boxPadding: 4,
            usePointStyle: true,
            titleFont: { weight: "bold" as const },
            itemSort: (a: TooltipItem<"bar">, b: TooltipItem<"bar">) => (b.parsed.y ?? 0) - (a.parsed.y ?? 0),
            filter: (item: TooltipItem<"bar">) => (item.parsed.y ?? 0) > 0,
            callbacks: {
              title: (items: TooltipItem<"bar">[]) => tooltipTitle(current[items[0].dataIndex], unit),
              label: (item: TooltipItem<"bar">) => ` ${item.dataset.label}: ${money((item.parsed.y ?? 0) * 100, 2)}`,
              footer: (items: TooltipItem<"bar">[]) =>
                items.length > 1 ? `Total: ${money(items.reduce((a, i) => a + (i.parsed.y ?? 0), 0) * 100, 2)}` : "",
            },
          },
        },
      },
    };
    chart?.destroy();
    chart = new Chart($<HTMLCanvasElement>("rev-canvas"), config);

    // Note under the chart.
    const notes: string[] = [];
    if (ok.some((p) => !p.complete)) notes.push("Older transactions of some products are still being added.");
    const skipped = [...new Set(ok.flatMap((p) => p.unconverted))];
    if (skipped.length) notes.push(`Revenue in ${skipped.join(", ")} is not included (no exchange rate set).`);
    const failed = projects.filter((p) => p.error).map((p) => p.label);
    if (failed.length) notes.push(`Couldn't load ${failed.join(", ")} right now.`);
    $("rev-note").textContent = notes.join(" ");
  }

  function fillPicker() {
    const select = $<HTMLSelectElement>("rev-project");
    const ok = projects.filter((p) => !p.error);
    select.innerHTML =
      `<option value="all">All products (${ok.length})</option>` +
      ok.map((p) => `<option value="${p.id}">${p.label.replace(/[<&]/g, "")}</option>`).join("");
    select.disabled = ok.length < 2;
    if (ok.length === 1) selected = ok[0].id;
    select.value = selected;
  }

  $("rev-project").addEventListener("change", (e) => {
    selected = (e.target as HTMLSelectElement).value;
    render();
  });
  document.querySelectorAll<HTMLButtonElement>("[data-range]").forEach((b) =>
    b.addEventListener("click", () => {
      range = b.dataset.range as RangeKey;
      document.querySelectorAll("[data-range]").forEach((x) => x.setAttribute("aria-selected", String(x === b)));
      render();
    }),
  );
  // Redraw with the right colours when the theme changes.
  matchMedia("(prefers-color-scheme: dark)").addEventListener("change", () => projects.length && render());
  // Close the TrustMRR menu when clicking elsewhere.
  document.addEventListener("click", (e) => {
    const menu = $<HTMLDetailsElement>("rev-verify-all");
    if (menu.open && !menu.contains(e.target as Node)) menu.open = false;
  });

  (async () => {
    try {
      projects = await loadProjects(CUR, RATES);
    } catch {
      projects = [];
    }
    if (projects.filter((p) => !p.error).length === 0) {
      $("rev-empty").textContent = projects.length ? "Couldn't load revenue right now." : "Revenue will appear here once products are connected.";
      return;
    }
    // Biggest project first (by the last 30 days). Projects without a custom name are numbered
    // by that rank, so "Project 1" is always the one earning the most right now.
    const { unit, current } = rangeKeys("30d");
    projects.sort((a, b) => sumKeys(b, unit, current) - sumKeys(a, unit, current));
    projects.forEach((p, i) => {
      if (/^(Project|Product) \d+$/i.test(p.label)) p.label = `Product ${i + 1}`;
    });
    fillPicker();
    render();

    // Short descriptions, in the same order and with the same names as the chart
    const about = $("about-products");
    const notes = JSON.parse(about.dataset.notes || "{}") as Record<string, string>;
    const list = $("product-notes");
    for (const p of projects.filter((p) => !p.error && notes[p.id]?.trim())) {
      const dt = document.createElement("dt");
      dt.textContent = p.label;
      const dd = document.createElement("dd");
      dd.textContent = notes[p.id].trim();
      list.append(dt, dd);
    }
    about.hidden = list.childElementCount === 0;
  })();
</script>
