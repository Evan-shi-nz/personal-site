---
import Base from "../../layouts/Base.astro";
import { render } from "astro:content";
import { getPosts, formatDate, isoDate } from "../../lib/content";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, date, updated, tags } = post.data;
---
<Base title={title} description={description} type="article" published={date}>
  <article>
    <header class="post-header">
      <h1>{title}</h1>
      <div class="meta">
        <time datetime={isoDate(date)}>{formatDate(date)}</time>
        {updated && <> · updated <time datetime={isoDate(updated)}>{formatDate(updated)}</time></>}
      </div>
      {tags.length > 0 && <div class="tags">{tags.map((t) => <span>#{t}</span>)}</div>}
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
  <hr />
  <p><a href="/blog">← All posts</a></p>
</Base>
