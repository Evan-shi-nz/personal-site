---
import Base from "../../layouts/Base.astro";
import { render } from "astro:content";
import { getPosts, formatDate, isoDate } from "../../lib/content";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({ params: { slug: post.id }, props: { post, newer: posts[i - 1], older: posts[i + 1] } }));
}

const { post, newer, older } = Astro.props;
const { Content } = await render(post);
const { title, description, date, updated, tags } = post.data;
---
<Base title={title} description={description} type="article" published={date} noindex={post.data.placeholder}>
  <article>
    <header class="post-header">
      <h1>{title}</h1>
      <div class="meta">
        <time datetime={isoDate(date)}>{formatDate(date)}</time>
        {updated && <> · updated <time datetime={isoDate(updated)}>{formatDate(updated)}</time></>}
      </div>
      {tags.length > 0 && <div class="tags">{tags.map((t) => <span>#{t}</span>)}</div>}
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
  <nav class="pager post-nav" aria-label="More posts">
    {newer ? <a href={`/blog/${newer.id}`} rel="prev"><span class="muted small">← Newer</span><span>{newer.data.title}</span></a> : <span />}
    {older ? <a href={`/blog/${older.id}`} rel="next" class="older"><span class="muted small">Older →</span><span>{older.data.title}</span></a> : <span />}
  </nav>
  <p class="small"><a href="/blog">All posts</a></p>
</Base>
