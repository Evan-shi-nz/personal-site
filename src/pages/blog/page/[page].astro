---
import Base from "../../../layouts/Base.astro";
import PostList from "../../../components/PostList.astro";
import Pager from "../../../components/Pager.astro";
import { getPosts, paginate } from "../../../lib/content";
import { site } from "../../../site.config";

// Page 1 is /blog; this route builds /blog/page/2 onwards.
export async function getStaticPaths() {
  return paginate(await getPosts(), site.pageSize.blog)
    .slice(1)
    .map((p) => ({ params: { page: String(p.page) }, props: p }));
}
const { items, page, pages } = Astro.props;
---
<Base title={`Blog, page ${page}`} description={`Evan Shi's blog, page ${page} of ${pages}.`}>
  <h1>Blog</h1>
  <PostList posts={items} />
  <Pager base="/blog" page={page} pages={pages} />
</Base>
