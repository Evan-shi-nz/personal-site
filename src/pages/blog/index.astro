---
import Base from "../../layouts/Base.astro";
import PostList from "../../components/PostList.astro";
import Pager from "../../components/Pager.astro";
import { getPosts, paginate } from "../../lib/content";
import { site } from "../../site.config";

const [first] = paginate(await getPosts(), site.pageSize.blog);
---
<Base title="Blog" description="Evan Shi writes about preparing for IELTS, moving to New Zealand and building small online products.">
  <h1>Blog</h1>
  <p class="muted">IELTS, moving to New Zealand, and building small products on my own.</p>
  <PostList posts={first.items} />
  <Pager base="/blog" page={first.page} pages={first.pages} />
</Base>
