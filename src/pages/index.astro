---
import Base from "../layouts/Base.astro";
import Social from "../components/Social.astro";
import PostList from "../components/PostList.astro";
import NoteCard from "../components/NoteCard.astro";
import { site } from "../site.config";
import { getPosts, getNotes } from "../lib/content";

const posts = (await getPosts()).slice(0, 6);
const notes = (await getNotes()).slice(0, 3);
---
<Base>
  <section class="intro">
    <img src={site.avatar} alt={`Portrait of ${site.name}`} width="96" height="96" />
    <div>
      <h1>{site.name}</h1>
      <p>{site.tagline}</p>
    </div>
  </section>
  <Social />

  <h2>Now</h2>
  <ul>
    {site.now.map((item) => <li>{item}</li>)}
  </ul>

  <a class="rev-mini" href="/revenue" id="rev-mini" hidden>
    <span class="small muted">Revenue, last 30 days</span>
    <strong id="rev-mini-value"></strong>
    <span class="small ok">✓ Verified with Stripe →</span>
  </a>

  <h2>Writing</h2>
  <PostList posts={posts} />
  <p><a href="/blog">All posts →</a></p>

  {notes.length > 0 && (
    <>
      <h2>Latest notes</h2>
      {notes.map((note) => <NoteCard note={note} />)}
      <p><a href="/notes">All notes →</a></p>
    </>
  )}

  <p class="small muted" style="margin-top:32px">Have a question or just want to say hi? <a href="/guestbook">Leave a message</a>.</p>
</Base>

<style>
  .rev-mini { display: inline-flex; flex-wrap: wrap; align-items: baseline; gap: 4px 12px; border: 1px solid var(--line); border-radius: 12px; padding: 10px 16px; text-decoration: none; color: var(--fg); margin-top: 4px; }
  .rev-mini:hover { border-color: var(--fg); }
  .rev-mini strong { font-size: 1.2rem; font-variant-numeric: tabular-nums; }
</style>

<script>
  // Last-30-day revenue across all projects; stays hidden until the verification keys are connected.
  (async () => {
    try {
      const { projects = [] } = await fetch("/api/revenue/projects").then((r) => r.json());
      const data = await Promise.all(
        projects.map((p: { id: string }) => fetch(`/api/revenue?project=${p.id}`).then((r) => (r.ok ? r.json() : null)).catch(() => null)),
      );
      const totals: Record<string, number> = {};
      for (const d of data) {
        if (!d || d.error) continue;
        for (const [cur, b] of Object.entries(d.last30Days ?? {})) totals[cur] = (totals[cur] ?? 0) + (b as { gross: number }).gross;
      }
      const [cur, minor] = Object.entries(totals).sort((a, b) => b[1] - a[1])[0] ?? [];
      if (!cur) return;
      document.getElementById("rev-mini-value")!.textContent = new Intl.NumberFormat("en-US", {
        style: "currency",
        currency: cur.toUpperCase(),
        maximumFractionDigits: 0,
      }).format(minor / 100);
      document.getElementById("rev-mini")!.hidden = false;
    } catch {}
  })();
</script>
