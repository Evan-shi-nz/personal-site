---
import Base from "../layouts/Base.astro";
import Social from "../components/Social.astro";
import { site } from "../site.config";
import { getPosts, getNotes, formatDate, isoDate } from "../lib/content";
import { render } from "astro:content";

const posts = (await getPosts()).slice(0, 6);
const notes = (await getNotes()).slice(0, 3);
const renderedNotes = await Promise.all(notes.map(async (n) => ({ note: n, Content: (await render(n)).Content })));
---
<Base>
  <section class="intro">
    <img src={site.avatar} alt={`Portrait of ${site.name}`} width="96" height="96" />
    <div>
      <h1>{site.name}</h1>
      <p>{site.tagline}</p>
    </div>
  </section>
  <Social />

  <h2>Now</h2>
  <ul>
    {site.now.map((item) => <li>{item}</li>)}
  </ul>
  <p class="small muted">
    My products earn real money. The numbers are public and anyone can <a href="/revenue">verify them against Stripe</a>.
  </p>

  <h2>Writing</h2>
  {posts.length === 0 && <p class="muted">No posts yet.</p>}
  <ul class="post-list">
    {posts.map((p) => (
      <li>
        <time datetime={isoDate(p.data.date)}>{formatDate(p.data.date)}</time>
        <a href={`/blog/${p.id}`}>{p.data.title}</a>
      </li>
    ))}
  </ul>
  <p><a href="/blog">All posts →</a></p>

  {renderedNotes.length > 0 && (
    <>
      <h2>Latest notes</h2>
      {renderedNotes.map(({ note, Content }) => (
        <article class="note">
          <div class="note-body"><Content /></div>
          <div class="note-meta">
            {formatDate(note.data.date)}
            {note.data.url && <> · <a href={note.data.url}>on X</a></>}
          </div>
        </article>
      ))}
      <p><a href="/notes">All notes →</a></p>
    </>
  )}
</Base>
