---
import { newTab } from "../lib/links";
import Base from "../layouts/Base.astro";
import resume from "../data/resume.json";

// Allow [text](url) links inside the summary and highlights; everything else is plain text.
const esc = (t: string) => t.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
const withLinks = (t: string) =>
  esc(t).replace(/\[([^\]]+)\]\(([^)\s]+)\)/g, (_, text, url) =>
    /^https?:\/\//.test(url) ? `<a href="${url}" target="_blank" rel="noopener noreferrer">${text}</a>` : `<a href="${url}">${text}</a>`,
  );
const achievements: string[] = (resume as { achievements?: string[] }).achievements ?? [];
const languages = resume.languages.map((l) => `${l.language} (${l.level})`).join(" · ");
---
<Base title="CV" description={`${resume.name}, ${resume.headline}. ${resume.location}.`}>
  <article class="cv">
    <header class="cv-head">
      <h1>{resume.name}</h1>
      <p class="role">{resume.headline}</p>
      <p class="contact">
        <span>{resume.location}</span>
        {resume.email && <a href={`mailto:${resume.email}`}>{resume.email}</a>}
        {resume.links.map((l) => <a href={l.url} {...newTab}>{l.label}</a>)}
      </p>
    </header>

    <p class="summary" set:html={withLinks(resume.summary)} />

    <section class="block">
      <h2>Experience</h2>
      <div class="items">
        {resume.experience.map((job) => (
          <div class="item">
            <div class="item-head">
              <span><strong>{job.role}</strong>, {job.company}</span>
              <span class="when">{job.start} – {job.end}</span>
            </div>
            {job.highlights.map((h) => <p class="detail" set:html={withLinks(h)} />)}
          </div>
        ))}
      </div>
    </section>

    <section class="block">
      <h2>Skills</h2>
      <dl class="items skills">
        {resume.skills.map((s) => (<><dt>{s.group}</dt><dd>{s.items.join(" · ")}</dd></>))}
      </dl>
    </section>

    <section class="block">
      <h2>Education</h2>
      <div class="items">
        {resume.education.map((e) => (
          <div class="item-head">
            <span><strong>{e.degree}</strong>, {e.school}</span>
            <span class="when">{e.start} – {e.end}</span>
          </div>
        ))}
      </div>
    </section>

    {achievements.length > 0 && (
      <section class="block">
        <h2>Other</h2>
        <div class="items">
          <p class="detail" set:html={achievements.map(withLinks).join(" · ")} />
        </div>
      </section>
    )}

    <section class="block">
      <h2>Languages</h2>
      <div class="items"><p class="detail">{languages}</p></div>
    </section>
  </article>
</Base>

<style>
  .cv { font-size: 15.5px; line-height: 1.6; }
  .cv-head h1 { margin: 0; font-size: 2rem; letter-spacing: -0.01em; }
  .role { margin: 2px 0 6px; font-size: 1.1rem; font-weight: 500; }
  .contact { display: flex; flex-wrap: wrap; gap: 2px 14px; margin: 0; font-size: 14px; color: var(--muted); }
  .contact a { color: var(--muted); }
  .summary { margin: 22px 0 6px; }

  /* Section name on the left, content on the right; stacked on phones */
  .block { display: grid; grid-template-columns: 120px 1fr; gap: 4px 20px; padding: 16px 0; border-top: 1px solid var(--line); }
  .block h2 { margin: 2px 0 0; font-size: 12px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }
  .items { display: flex; flex-direction: column; gap: 12px; min-width: 0; margin: 0; }
  .item-head { display: flex; justify-content: space-between; align-items: baseline; gap: 2px 16px; flex-wrap: wrap; }
  .when { color: var(--muted); font-size: 14px; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .detail { margin: 2px 0 0; color: var(--muted); }
  :global(.cv .detail a) { color: var(--muted); }
  .skills { display: grid; grid-template-columns: max-content 1fr; gap: 4px 16px; }
  .skills dt { font-weight: 600; }
  .skills dd { margin: 0; color: var(--muted); }

  @media (max-width: 560px) {
    .block { grid-template-columns: 1fr; gap: 8px; }
    .skills { grid-template-columns: 1fr; gap: 0; }
    .skills dd { margin-bottom: 6px; }
  }

  /* Printing from the browser gives a clean one-page CV */
  @media print {
    :global(.site-header), :global(.site-footer) { display: none !important; }
    :global(body) { background: #fff; color: #000; }
    :global(.container) { max-width: none; padding: 0; }
    .cv { font-size: 10.5pt; }
    .detail, .skills dd, .when, .contact, .contact a, .block h2 { color: #333; }
    .block { padding: 10px 0; break-inside: avoid; }
    @page { margin: 14mm; }
  }
</style>
