---
import { newTab } from "../lib/links";
import Base from "../layouts/Base.astro";
import { site } from "../site.config";

// Projects and numbers come from /api/revenue at runtime (Cloudflare secret STRIPE_REVENUE_KEYS),
// so adding a project needs no rebuild. Keys never reach the browser.
const { currency, rates } = site.revenue;
---
<Base title="Revenue" description="Evan Shi's revenue from small online products, read from Stripe and verified on TrustMRR.">
  <h1>Revenue</h1>
  <p class="muted">
    I run small online products on my own. I don't name them here, but the revenue is real:
    it is read straight from Stripe, and each project is independently verified on TrustMRR.
  </p>

  <section class="rev-card" id="rev" data-currency={currency} data-rates={JSON.stringify(rates)} aria-live="polite">
    <div class="table-wrap">
      <table class="rev-table">
        <thead>
          <tr>
            <th scope="col">Project</th>
            <th scope="col" class="num">Last 30 days</th>
            <th scope="col" class="num chg">Change</th>
            <th scope="col" class="num">All-time</th>
            <th scope="col">Verified</th>
          </tr>
        </thead>
        <tbody id="rev-rows">
          <tr><td colspan="5" class="muted">Loading revenue from Stripe…</td></tr>
        </tbody>
      </table>
    </div>
    <p class="small muted note" id="rev-note"></p>

    <div id="rev-chart" hidden>
      <div class="chart-head">
        <span class="small muted" id="chart-title"></span>
        <div class="range-tabs" role="tablist" aria-label="Range">
          <button type="button" role="tab" data-range="months" aria-selected="true">Monthly</button>
          <button type="button" role="tab" data-range="days" aria-selected="false">Daily</button>
        </div>
      </div>
      <div id="chart-body"></div>
    </div>
  </section>

  <p class="small muted">
    Each project is verified on <a href="https://trustmrr.com" {...newTab}>TrustMRR</a>, which reads its revenue
    directly from Stripe. Use the links in the table to check each one.
  </p>
</Base>

<style>
  .rev-card { border: 1px solid var(--line); border-radius: 14px; padding: 6px 18px 16px; margin: 24px 0 8px; }
  .rev-table { min-width: 520px; }
  .rev-table th, :global(.rev-table td) { padding: 12px 12px 12px 0; }
  :global(.rev-table .num) { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
  :global(.rev-table tbody tr[data-row]) { cursor: pointer; }
  :global(.rev-table tbody tr[data-row]:hover td) { background: var(--soft); }
  :global(.rev-table tbody tr[aria-selected="true"] td:first-child) { box-shadow: inset 3px 0 0 var(--fg); }
  :global(.rev-table td:first-child), .rev-table th:first-child { padding-left: 10px; white-space: nowrap; }
  :global(.rev-table tr.total td) { font-weight: 700; border-bottom: 2px solid var(--fg); }
  :global(.rev-table .big) { font-size: 1.1rem; font-weight: 700; }
  :global(.rev-table a.verify) { white-space: nowrap; font-size: 14px; }
  :global(.delta.up) { color: var(--good); }
  :global(.delta.down) { color: #d4483b; }
  .note { margin: 10px 0 18px; }
  /* Phones: drop the Change column so totals and TrustMRR links fit without scrolling */
  @media (max-width: 560px) {
    .rev-card { padding: 4px 12px 14px; }
    .rev-table { min-width: 0; font-size: 15px; }
    :global(.rev-table .chg) { display: none; }
    .rev-table th, :global(.rev-table td) { padding: 10px 8px 10px 0; }
    :global(.rev-table .big) { font-size: 1rem; }
    :global(.rev-table a.verify) { font-size: 13px; }
  }
  .note:empty { display: none; }
  :global(.chart-head) { display: flex; justify-content: space-between; align-items: center; gap: 8px; flex-wrap: wrap; margin-bottom: 6px; }
  :global(.range-tabs) { display: inline-flex; gap: 4px; }
  :global(.range-tabs button) { background: transparent; color: var(--muted); border: 1px solid var(--line); padding: 3px 10px; font-size: 13px; border-radius: 99px; }
  :global(.range-tabs button[aria-selected="true"]) { background: var(--fg); color: var(--bg); border-color: var(--fg); }
  :global(.chart) { position: relative; }
  :global(.chart svg) { display: block; width: 100%; height: 170px; }
  :global(.chart .bar) { fill: var(--fg); pointer-events: none; }
  :global(.chart .bar.zero) { fill: var(--line); }
  :global(.chart .hit:hover + .bar) { fill: var(--good); }
  :global(.chart .grid) { stroke: var(--line); stroke-width: 1; }
  :global(.axis) { display: flex; justify-content: space-between; font-size: 12px; color: var(--muted); font-variant-numeric: tabular-nums; margin-top: 4px; }
  :global(.tip) { position: absolute; top: 0; transform: translateX(-50%); background: var(--fg); color: var(--bg); font-size: 12px; padding: 4px 8px; border-radius: 6px; pointer-events: none; white-space: nowrap; font-variant-numeric: tabular-nums; }
  :global(.ymax) { position: absolute; top: -2px; left: 0; font-size: 12px; color: var(--muted); background: var(--bg); padding-right: 4px; }
</style>

<script>
  type Bucket = { gross: number; refunds: number; disputes: number; fees: number; net: number; payments: number };
  type Currency = { total: Bucket; months: Record<string, Bucket>; days: Record<string, Bucket> };
  type Project = { id: string; label: string; trustmrr?: string | null };
  type Data = {
    generatedAt?: string;
    complete?: boolean;
    currencies?: Record<string, Currency>;
    last30Days?: Record<string, Bucket>;
    previous30Days?: Record<string, Bucket>;
    error?: string;
  };
  // One row of the table, already converted to the display currency (in cents)
  type Row = {
    id: string;
    label: string;
    trustmrr?: string | null;
    last30: number;
    prev30: number;
    allTime: number;
    months: Record<string, number>;
    days: Record<string, number>;
    error?: string;
    complete: boolean;
    unconverted: string[];
    generatedAt?: string;
  };

  const box = document.getElementById("rev")!;
  const CUR = box.dataset.currency!;
  const RATES: Record<string, number> = JSON.parse(box.dataset.rates!);
  const API = "/api/revenue";
  const $ = (id: string) => document.getElementById(id)!;
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]!);
  const money = (cents: number, digits = 0) =>
    new Intl.NumberFormat("en-US", { style: "currency", currency: CUR.toUpperCase(), maximumFractionDigits: digits, minimumFractionDigits: digits }).format(cents / 100);
  const zeroDecimal = new Set(["jpy", "krw", "vnd", "clp", "pyg", "ugx", "xaf", "xof"]);

  // Amount in a currency's minor units -> display currency cents. null if no rate is configured.
  function convert(minor: number, cur: string): number | null {
    const rate = RATES[cur];
    if (!rate) return null;
    const major = zeroDecimal.has(cur) ? minor : minor / 100;
    return Math.round((major / rate) * (RATES[CUR] ?? 1) * 100);
  }

  function toRow(p: Project, d: Data): Row {
    const row: Row = { id: p.id, label: p.label, trustmrr: p.trustmrr, last30: 0, prev30: 0, allTime: 0, months: {}, days: {}, complete: d.complete !== false, unconverted: [], generatedAt: d.generatedAt };
    if (d.error) return { ...row, error: d.error };
    for (const [cur, c] of Object.entries(d.currencies ?? {})) {
      if (c.total.gross <= 0) continue; // fee-only currency
      if (convert(1, cur) === null) {
        row.unconverted.push(cur.toUpperCase());
        continue;
      }
      row.allTime += convert(c.total.gross, cur)!;
      row.last30 += convert(d.last30Days?.[cur]?.gross ?? 0, cur)!;
      row.prev30 += convert(d.previous30Days?.[cur]?.gross ?? 0, cur)!;
      for (const [k, b] of Object.entries(c.months)) row.months[k] = (row.months[k] ?? 0) + convert(b.gross, cur)!;
      for (const [k, b] of Object.entries(c.days ?? {})) row.days[k] = (row.days[k] ?? 0) + convert(b.gross, cur)!;
    }
    return row;
  }

  function totalRow(rows: Row[]): Row {
    const ok = rows.filter((r) => !r.error);
    const t: Row = { id: "total", label: "Total", last30: 0, prev30: 0, allTime: 0, months: {}, days: {}, complete: ok.every((r) => r.complete), unconverted: [] };
    for (const r of ok) {
      t.last30 += r.last30;
      t.prev30 += r.prev30;
      t.allTime += r.allTime;
      for (const [k, v] of Object.entries(r.months)) t.months[k] = (t.months[k] ?? 0) + v;
      for (const [k, v] of Object.entries(r.days)) t.days[k] = (t.days[k] ?? 0) + v;
    }
    return t;
  }

  function change(now: number, before: number) {
    if (!before) return now ? `<span class="delta up">New</span>` : `<span class="muted">–</span>`;
    const pct = ((now - before) / before) * 100;
    return `<span class="delta ${pct >= 0 ? "up" : "down"}">${pct >= 0 ? "↑" : "↓"} ${Math.abs(pct).toFixed(1)}%</span>`;
  }

  function timeAgo(iso: string) {
    const min = Math.round((Date.now() - new Date(iso).getTime()) / 60000);
    if (min < 1) return "just now";
    if (min < 60) return `${min} min ago`;
    const h = Math.round(min / 60);
    return `${h} hour${h > 1 ? "s" : ""} ago`;
  }

  let rows: Row[] = [];
  let total: Row;
  let selected = "total";
  let range: "months" | "days" = "months";

  function renderTable() {
    $("rev-rows").innerHTML = [total, ...rows]
      .map((r) => {
        const cls = r.id === "total" ? ' class="total"' : "";
        const verify = r.trustmrr
          ? `<a class="verify" href="${esc(r.trustmrr)}" target="_blank" rel="noopener noreferrer">TrustMRR ↗</a>`
          : `<span class="muted">–</span>`;
        if (r.error) {
          return `<tr${cls}><td>${esc(r.label)}</td><td colspan="3" class="muted small">Couldn't load right now</td><td>${verify}</td></tr>`;
        }
        return `<tr${cls} data-row="${esc(r.id)}" tabindex="0" aria-selected="${r.id === selected}">
          <td>${esc(r.label)}</td>
          <td class="num big">${money(r.last30)}</td>
          <td class="num chg">${change(r.last30, r.prev30)}</td>
          <td class="num">${money(r.allTime)}</td>
          <td>${r.id === "total" ? "" : verify}</td>
        </tr>`;
      })
      .join("");

    const notes = [`Revenue before fees, in ${CUR.toUpperCase()} (HK$7.80 = US$1). Select a row to see its chart.`];
    const updated = rows.map((r) => r.generatedAt).filter(Boolean).sort()[0];
    if (updated) notes.push(`Updated ${timeAgo(updated!)}.`);
    if (!total.complete) notes.push("Older transactions of some projects are still being added.");
    const skipped = [...new Set(rows.flatMap((r) => r.unconverted))];
    if (skipped.length) notes.push(`Revenue in ${skipped.join(", ")} is not included (no exchange rate set).`);
    $("rev-note").textContent = notes.join(" ");
  }

  function label(key: string) {
    if (range === "months") {
      const [y, m] = key.split("-").map(Number);
      return new Date(Date.UTC(y, m - 1, 1)).toLocaleDateString("en-NZ", { month: "short", year: "numeric", timeZone: "UTC" });
    }
    return new Date(key + "T00:00:00Z").toLocaleDateString("en-NZ", { day: "numeric", month: "short", timeZone: "UTC" });
  }

  function renderChart() {
    const r = selected === "total" ? total : rows.find((x) => x.id === selected) ?? total;
    let series = Object.entries(range === "months" ? r.months : r.days).sort(([a], [b]) => a.localeCompare(b));
    if (range === "months") series = series.slice(-24);
    $("rev-chart").hidden = false;
    $("chart-title").textContent = `${r.label}: revenue per ${range === "months" ? "month" : "day, last 90 days"}`;
    document.querySelectorAll<HTMLButtonElement>("[data-range]").forEach((b) => b.setAttribute("aria-selected", String(b.dataset.range === range)));
    if (series.length === 0) {
      $("chart-body").innerHTML = `<p class="muted small">No revenue yet.</p>`;
      return;
    }
    const W = 600, H = 170, gap = series.length > 40 ? 1 : 3;
    const max = Math.max(1, ...series.map(([, v]) => v));
    const bw = (W - gap * (series.length - 1)) / series.length;
    const bars = series
      .map(([, v], i) => {
        const h = v > 0 ? Math.max(2, (v / max) * (H - 16)) : 2;
        const x = i * (bw + gap);
        return `<rect class="hit" x="${x}" y="0" width="${bw + gap}" height="${H}" fill="transparent" data-i="${i}"></rect><rect class="bar${v ? "" : " zero"}" x="${x}" y="${H - h}" width="${bw}" height="${h}" rx="${Math.min(3, bw / 2)}"></rect>`;
      })
      .join("");
    $("chart-body").innerHTML = `
      <div class="chart" id="chart">
        <span class="ymax">${money(max)}</span>
        <svg viewBox="0 0 ${W} ${H}" preserveAspectRatio="none" role="img" aria-label="${esc(r.label)} revenue per ${range === "months" ? "month" : "day"}">
          <line class="grid" x1="0" y1="${H - 0.5}" x2="${W}" y2="${H - 0.5}"></line>${bars}
        </svg>
        <div class="tip" id="tip" hidden></div>
      </div>
      <div class="axis"><span>${label(series[0][0])}</span><span>${label(series[series.length - 1][0])}</span></div>`;
    const chart = $("chart"), tip = $("tip");
    chart.querySelectorAll<SVGRectElement>(".hit").forEach((rect) => {
      const show = () => {
        const [k, v] = series[Number(rect.dataset.i)];
        tip.textContent = `${label(k)} · ${money(v, 2)}`;
        tip.hidden = false;
        const rb = rect.getBoundingClientRect(), cb = chart.getBoundingClientRect();
        const half = tip.offsetWidth / 2;
        tip.style.left = `${Math.min(Math.max(rb.left - cb.left + rb.width / 2, half), cb.width - half)}px`;
      };
      rect.addEventListener("mouseenter", show);
      rect.addEventListener("touchstart", show, { passive: true });
    });
    chart.addEventListener("mouseleave", () => (tip.hidden = true));
  }

  function select(id: string) {
    selected = id;
    renderTable();
    renderChart();
  }

  $("rev-rows").addEventListener("click", (ev) => {
    if ((ev.target as HTMLElement).closest("a")) return; // let TrustMRR links open
    const tr = (ev.target as HTMLElement).closest<HTMLTableRowElement>("tr[data-row]");
    if (tr) select(tr.dataset.row!);
  });
  $("rev-rows").addEventListener("keydown", (ev) => {
    const tr = (ev.target as HTMLElement).closest<HTMLTableRowElement>("tr[data-row]");
    if (tr && (ev.key === "Enter" || ev.key === " ")) {
      ev.preventDefault();
      select(tr.dataset.row!);
    }
  });
  document.querySelectorAll<HTMLButtonElement>("[data-range]").forEach((b) =>
    b.addEventListener("click", () => {
      range = b.dataset.range as typeof range;
      renderChart();
    }),
  );

  async function load() {
    let projects: Project[] = [];
    try {
      projects = (await fetch(`${API}/projects`).then((r) => r.json())).projects ?? [];
    } catch {}
    if (projects.length === 0) {
      $("rev-rows").innerHTML = `<tr><td colspan="5" class="muted">Revenue will appear here once the projects are connected.</td></tr>`;
      return;
    }
    rows = await Promise.all(
      projects.map(async (p) => {
        try {
          const res = await fetch(`${API}?project=${encodeURIComponent(p.id)}`);
          const d: Data = await res.json();
          return toRow(p, res.ok ? d : { ...d, error: d.error || `HTTP ${res.status}` });
        } catch (err) {
          return toRow(p, { error: String((err as Error).message) });
        }
      }),
    );
    total = totalRow(rows);
    renderTable();
    renderChart();
  }

  load();
</script>
